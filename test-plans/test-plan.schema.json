{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecore-openspec-poc/schemas/test-plan.schema.json",
  "title": "Business Test Plan",
  "description": "Generated only from approved acceptance criteria, approved OpenSpec artifacts, Jira source context and existing RTM relationships. Business-level only - no automation implementation detail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testPlanId",
    "artifactVersion",
    "release",
    "capability",
    "jiraStoryIds",
    "requirementIds",
    "acIds",
    "objective",
    "scope",
    "assumptions",
    "dependencies",
    "risks",
    "scenarios",
    "environmentRequirements",
    "entryCriteria",
    "exitCriteria",
    "coverageMappings",
    "clarifications",
    "approvalStatus",
    "dataClassification",
    "timestamps"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "testPlanId": { "type": "string", "pattern": "^TP-[A-Z0-9-]+-[0-9]{3}$" },
    "artifactVersion": { "type": "integer", "minimum": 1 },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "capability": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "jiraStoryIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" }
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^REQ-[A-Z][A-Z0-9]+-[0-9]+-[0-9]{3}$" }
    },
    "acIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^AC-[A-Z][A-Z0-9]+-[0-9]+-[0-9]{3}$" }
    },
    "openSpecRefs": { "type": "array", "items": { "type": "string" } },
    "objective": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope", "outOfScope"],
      "properties": {
        "inScope": { "type": "array", "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["riskId", "description", "level"],
        "properties": {
          "riskId": { "type": "string", "pattern": "^RISK-TP-[A-Z0-9-]+-[0-9]{3}$" },
          "description": { "type": "string", "minLength": 1 },
          "level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "mitigation": { "type": ["string", "null"] }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "environmentRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "notes"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["local", "dev", "qa", "uat", "staging"]
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entryCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exitCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "coverageMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acId", "testScenarioIds"],
        "properties": {
          "acId": { "type": "string", "pattern": "^AC-[A-Z][A-Z0-9]+-[0-9]+-[0-9]{3}$" },
          "testScenarioIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TS-[A-Z0-9-]+-[0-9]{3}$" }
          }
        }
      }
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clarificationId", "question", "status"],
        "properties": {
          "clarificationId": { "type": "string", "pattern": "^(AMB|CLR)-[A-Z0-9-]+-[0-9]{3}$" },
          "question": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["REVIEW_REQUIRED", "RESOLVED", "DEFERRED"]
          }
        }
      }
    },
    "approvalStatus": {
      "type": "string",
      "enum": [
        "PENDING_TEST_PLAN_APPROVAL",
        "APPROVED",
        "REJECTED",
        "DEFERRED",
        "REQUEST_CHANGES",
        "REVIEW_REQUIRED"
      ]
    },
    "approvalRef": { "type": ["string", "null"] },
    "dataClassification": {
      "type": "string",
      "enum": ["REAL_JIRA_DATA", "SAMPLE_DATA"]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "updatedAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "approvedAt": {
          "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
        }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testScenarioId",
        "title",
        "type",
        "acIds",
        "preconditions",
        "steps",
        "expectedResult",
        "testDataRequirements",
        "automationCandidate",
        "priority"
      ],
      "properties": {
        "testScenarioId": { "type": "string", "pattern": "^TS-[A-Z0-9-]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["POSITIVE", "NEGATIVE", "BOUNDARY"]
        },
        "acIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^AC-[A-Z][A-Z0-9]+-[0-9]+-[0-9]{3}$" }
        },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expectedResult": { "type": "string", "minLength": 1 },
        "testDataRequirements": { "type": "array", "items": { "type": "string" } },
        "automationCandidate": { "type": "boolean" },
        "automationDecision": {
          "type": "string",
          "enum": ["AUTOMATE", "MANUAL_ONLY", "DEFERRED", "REVIEW_REQUIRED"]
        },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "riskTag": {
          "type": ["string", "null"],
          "enum": ["risk-low", "risk-medium", "risk-high", null]
        },
        "suiteTag": {
          "type": ["string", "null"],
          "enum": ["suite-smoke", "suite-regression", "suite-critical", null]
        },
        "scenarioAction": {
          "type": "string",
          "enum": ["REUSE", "UPDATE", "CREATE", "RETIRE", "REGRESSION", "REVIEW_REQUIRED"]
        },
        "interfaceType": {
          "type": "string",
          "description": "Which interface the scenario exercises. Absent means UI.",
          "enum": ["UI", "API", "HYBRID"]
        },
        "apiContract": { "$ref": "#/$defs/apiContract" },
        "reuseSource": { "$ref": "#/$defs/reuseSource" }
      }
    },
    "reuseSource": {
      "type": "object",
      "description": "Present only when scenarioAction is REUSE and this scenario's evidence is another story's already-validated scenario. status starts PROPOSED; it may not back an APPROVED plan until a human confirms it at Gate 2.",
      "additionalProperties": false,
      "required": ["sourceJiraStoryId", "sourceTestScenarioId", "matchedLayers", "rationale", "status"],
      "properties": {
        "sourceJiraStoryId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
        "sourceTestScenarioId": { "type": "string", "pattern": "^TS-[A-Z0-9-]+-[0-9]{3}$" },
        "matchedLayers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["AC_TEXT", "BEHAVIOR", "INTERFACE_TYPE", "DATA_CLASSIFICATION", "REQUIREMENT_VERSION", "RELEASE_SCOPE"]
          }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["PROPOSED", "CONFIRMED"] }
      }
    },
    "apiContract": {
      "type": "object",
      "description": "Required when interfaceType is API or HYBRID. Agreed at Approval Gate 2.",
      "additionalProperties": false,
      "required": ["method", "path", "expectedStatusCodes", "contractSource", "contractProvenance"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "path": { "type": "string", "minLength": 1 },
        "expectedStatusCodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "contractSource": {
          "type": "string",
          "description": "OBSERVED describes what the application does, not what it should do, and may never back an assertion on an approved acceptance criterion.",
          "enum": ["OPENAPI", "HUMAN_APPROVED", "OBSERVED", "UNVERIFIED"]
        },
        "contractProvenance": {
          "type": "string",
          "minLength": 1,
          "description": "OpenAPI URL, APR-TP-* approval id, or the validation report the traffic was observed in. A value beginning AGENT_DRAFTED marks a contract an agent composed on explicit human instruction: it stays UNVERIFIED and must carry DICTATED: and PROPOSED: segments naming which fields a human supplied."
        },
        "responseContractRef": { "type": ["string", "null"], "minLength": 1 },
        "responseShapeHash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 of the response shape agreed at Gate 2: keys and types only, never values. Lets a later run detect that a HUMAN_APPROVED contract has drifted."
        },
        "scaffoldingOnly": {
          "type": "boolean",
          "description": "True when the call only reaches a state. Scaffolding never counts as acceptance-criteria coverage."
        }
      }
    }
  }
}

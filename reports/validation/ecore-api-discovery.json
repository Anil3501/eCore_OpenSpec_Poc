      "contractSource": "OBSERVED",
      "trigger": "Results grid population after a transaction search",
      "requestEncoding": "application/x-www-form-urlencoded",
      "requestParameterShape": "DataTables server-side protocol: draw, and a repeated columns[i]['data'|'name'|'searchable'|'orderable'|'visible'] plus columns[i]['search'][value|regex] block per column.",
      "responseStatus": 200,
      "responseContentType": "application/json;charset=UTF-8",
      "responseEnvelopeKeys": ["draw", "recordsTotal", "recordsFiltered", "data"],
      "rowFieldNames": [
        "DT_RowId", "DT_RowClass", "DT_RowData",
        "containerName", "orgFullName", "dateCreated", "status", "containerVaultId",
        "children", "endDispositionDate", "externalReference1", "externalReference2",
        "externalReference3", "loanId", "transactionGuid", "electronicOriginalDocCount",
        "storedDocumentCount", "retentionCopyCount", "transferReceiptCount",
        "emptyDocumentProfileCount", "transferredTo", "transferredToAt", "transferredFrom",
        "transferredFromAt", "billingType", "assetType", "transactionCreator",
        "containsAiData", "transactionType", "containerPermission", "isLocked",
        "lockedReason", "securitiesIntermediary", "entitlementHolder", "rightsHolder",
        "createdBy", "poaAgents", "mersController", "mersLocation", "mersDelegatee",
        "mersSubservicer", "mersDelegateeForTransfer", "mersSecuredParty",
        "mersSecuredPartyDelegatee", "mersPreviousSecuredParty",
        "mersPreviousSecuredPartyDelegatee", "mersRegisteredBy", "mersRegisteredAt",
        "mersDeactivatedOn", "mersTampersealedAt"
      ],
      "criticalCaveat": "Every business field is an HTML STRING, not a value: the payload carries \"<span title='...'>value</span>\", not \"value\". Only recordsTotal, recordsFiltered and draw are plain numbers. A Zod contract for this endpoint would be validating presentation markup, so it can support state setup but must never assert an acceptance criterion."
    }
  ],


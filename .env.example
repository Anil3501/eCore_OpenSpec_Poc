# Template only. Copy to .env and fill in real values.
# NEVER put a real secret in this file - it IS committed.

# --- Playwright / application under test ---------------------------------
# Optional environment profile selector. When set (or passed via --env=<name>),
# the framework loads config/environments/<profile>.json or .env.<profile> with fallback to .env.
TEST_ENV_PROFILE=
PLAYWRIGHT_BASE_URL=https://example.test
# local | dev | qa | uat | staging | prod
TEST_ENVIRONMENT=qa
HEADLESS=true

# --- API under test -------------------------------------------------------
# Deliberately NOT derived from PLAYWRIGHT_BASE_URL: the API usually lives on a
# different host, port or path prefix, and a silently wrong derived URL gives a
# confusing 404 instead of a clear configuration error. Leave empty until an
# API scenario exists; UI-only runs never touch it.
API_BASE_URL=
# NONE | BEARER | BASIC | SESSION_COOKIE
# SESSION_COOKIE reuses the browser context's storage state, which is what makes
# a hybrid scenario (seed over the API, assert in the signed-in UI) possible.
API_AUTH_MODE=NONE
# Required only for BEARER and BASIC. Never logged.
API_AUTH_TOKEN=


# --- Browser code coverage (v8-to-istanbul) -------------------------------
# On by default: every `npm test` writes the execution report and the coverage
# report together. Set false for a faster run with no capture. Chromium only.
# This is application CODE coverage and is never evidence of requirement
# coverage. `npm run test:coverage` forces capture on even when this is false.
COVERAGE_ENABLED=true
# When false, only scripts served from PLAYWRIGHT_BASE_URL's origin are
# recorded. Set true to also record CDN / third-party scripts.
COVERAGE_INCLUDE_THIRD_PARTY=false

# --- eCore application login ---------------------------------------------
# ECORE_LOGIN_TYPE is the label of the login mode selected on the login page,
# for example "Organization Login".
ECORE_LOGIN_TYPE=
ECORE_USERNAME=
ECORE_ORGANIZATION=
ECORE_ORGANIZATION_ID=
ECORE_PASSWORD=

# Generic aliases. If left empty, the env loader falls back to
# ECORE_USERNAME / ECORE_PASSWORD.
TEST_USERNAME=
TEST_PASSWORD=

# --- eCore /ecore/ eoLogin / eoRequestExport integration API --------------
# A dedicated, API-enabled account, distinct from ECORE_USERNAME above (eCore
# rejects eoLogin for a non-API account with API_KEY_INVALID_FOR_NON_APIUSER).
# Organization is not duplicated here - it reuses ECORE_ORGANIZATION above.
ECORE_API_BASE_URL=
ECORE_API_LOGIN_USERNAME=
ECORE_API_KEY=

# --- Jira (Atlassian) -----------------------------------------------------
# The Atlassian MCP server uses interactive OAuth. These values exist only for
# a direct Jira REST fallback.
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Automated bug filing (bug-analyzer agent) ----------------------------
# Where defect tickets are created. Leave empty to reuse JIRA_PROJECT_KEY.
JIRA_BUG_PROJECT_KEY=
# Issue type name in the target project. Defaults to "Bug" when empty.
JIRA_BUG_ISSUE_TYPE=
# Atlassian accountId that every filed bug is assigned to for review.
# Required before the agent is allowed to file anything.
JIRA_BUG_ASSIGNEE_ACCOUNT_ID=
# Recorded in the defect artifact's jira.linkType field for this framework's own
# traceability only. No live Jira issue link is created (bug-analyzer no longer
# calls createIssueLink). Defaults to "Relates" when empty.
JIRA_BUG_LINK_TYPE=
# A Playwright trace.zip can embed request headers, cookies and typed form
# values. Set false to withhold traces from Jira; the defect artifact then
# records `attachmentsWithheld: true` instead of silently dropping evidence.
BUG_ATTACH_TRACE=true


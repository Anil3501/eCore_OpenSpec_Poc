{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecore-openspec-poc/schemas/workflow-history.schema.json",
  "title": "Workflow history event",
  "description": "One line of workflow/history/<workflowId>.history.jsonl. The file is append-only: an event is never edited or deleted, only superseded by a later correcting event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "workflowId", "occurredAt", "actor", "event", "stage", "notes"],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^EVT-WF-[A-Z0-9-]+-R[0-9]+\\.[0-9]+(\\.[0-9]+)?-[0-9]{3}$"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^WF-[A-Z0-9-]+-R[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actor": {
      "type": ["string", "null"],
      "description": "The agent or human that caused the event. Null only when it genuinely cannot be attributed."
    },
    "event": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Deliberately not an enum. History is append-only, so freezing the vocabulary would retroactively invalidate events that were correct when written."
    },
    "stage": {
      "type": "string",
      "enum": [
        "JIRA_RETRIEVAL",
        "REQUIREMENT_NORMALIZATION",
        "AC_ANALYSIS",
        "AC_REVIEW_PACKAGE",
        "AC_APPROVAL",
        "OPENSPEC_GENERATION",
        "TEST_PLAN_GENERATION",
        "TEST_PLAN_APPROVAL",
        "BDD_DESIGN",
        "AUTOMATION_REVIEW_PACKAGE",
        "AUTOMATION_APPROVAL",
        "PLAYWRIGHT_VALIDATION",
        "IMPLEMENTATION",
        "BDD_GENERATION",
        "EXECUTION",
        "FAILURE_TRIAGE",
        "LOCATOR_HEALING",
        "BUG_REPORTING",
        "RTM_UPDATE",
        "OPENSPEC_ARCHIVE",
        "COMPLETED"
      ]
    },
    "notes": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "VALIDATION_FAILED",
        "WAITING_FOR_CLARIFICATION",
        "WAITING_FOR_HUMAN",
        "APPROVED",
        "REJECTED",
        "CHANGES_REQUESTED",
        "BLOCKED",
        "COMPLETED"
      ]
    },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "delegatedTo": { "type": "string", "minLength": 1 },
    "errorCode": { "type": "string", "minLength": 1 },
    "reconstructed": {
      "type": "boolean",
      "description": "True when the event was rebuilt from other evidence rather than written as it happened."
    }
  }
}

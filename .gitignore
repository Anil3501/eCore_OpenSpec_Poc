# Dependencies
node_modules/

# Local environment (never commit)
.env
.env.local
.env.*.local
.npmrc

# Playwright execution artifacts
test-results/
playwright-report/
blob-report/
.playwright-cache/

# Playwright-BDD generated tests (regenerated by `npm run bdd`)
.features-gen/

# Browser code coverage (regenerated by `npm run test:coverage`)
reports/coverage/

# Preserved failure evidence: screenshots and trace.zip copied out of
# test-results/ by `npm run triage:failures`. A trace can embed request headers
# and typed form values, so it is never committed. The governed defect artifact
# in defects/ IS committed and references these paths.
reports/defects/

# Local authenticated session / storage state (never commit)
.auth/

# Playwright MCP scratch output: page snapshots, console logs and screenshots
# written during agent exploration. A snapshot can contain live customer data.
.playwright-mcp/

# Temporary execution artifacts
*.tmp
*.log
reports/execution/*.tmp.json
reports/execution/results.json
workflow/queues/*.lock

# OS / editor noise
.DS_Store
Thumbs.db

# Explicitly tracked (do NOT ignore)
!.env.example
!openspec/
!requirements/approved/
!test-plans/approved/
!features/approved/
!workflow/
!traceability/

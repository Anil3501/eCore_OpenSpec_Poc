{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecore-openspec-poc/schemas/coverage-matrix.schema.json",
  "title": "Coverage Matrix",
  "description": "Derived strictly from RTM data. Percentages are null whenever the source data required to compute them is missing. A 100% value is only permitted when RTM data proves it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "release",
    "generatedAt",
    "dataClassification",
    "sourceRtm",
    "totals",
    "coverage",
    "gaps"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "capability": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "dataClassification": {
      "type": "string",
      "enum": ["REAL_JIRA_DATA", "SAMPLE_DATA"]
    },
    "sourceRtm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedAcs",
        "approvedAcsLinkedToApprovedScenarios",
        "approvedAcsLinkedToExecutableAutomation",
        "automatedAcsExecuted",
        "executedAcsPassed"
      ],
      "properties": {
        "approvedAcs": { "type": "integer", "minimum": 0 },
        "approvedAcsLinkedToApprovedScenarios": { "type": "integer", "minimum": 0 },
        "approvedAcsLinkedToExecutableAutomation": { "type": "integer", "minimum": 0 },
        "automatedAcsExecuted": { "type": "integer", "minimum": 0 },
        "executedAcsPassed": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acDesignCoveragePct",
        "automationCoveragePct",
        "executionCoveragePct",
        "passCoveragePct"
      ],
      "properties": {
        "acDesignCoveragePct": { "$ref": "#/$defs/percentage" },
        "automationCoveragePct": { "$ref": "#/$defs/percentage" },
        "executionCoveragePct": { "$ref": "#/$defs/percentage" },
        "passCoveragePct": { "$ref": "#/$defs/percentage" },
        "byInterface": {
          "description": "Optional. Absent means the split was never measured, which is not the same as a capability having no API coverage. Browser code coverage is unrelated and is never merged here.",
          "type": "object",
          "additionalProperties": false,
          "required": ["UI", "API", "HYBRID"],
          "properties": {
            "UI": { "$ref": "#/$defs/interfaceCoverage" },
            "API": { "$ref": "#/$defs/interfaceCoverage" },
            "HYBRID": { "$ref": "#/$defs/interfaceCoverage" }
          }
        }
      }
    },
    "gaps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncoveredAcIds",
        "deferredAcIds",
        "blockedAcIds",
        "manualOnlyAcIds",
        "failedAcIds",
        "clarificationRequiredAcIds"
      ],
      "properties": {
        "uncoveredAcIds": { "$ref": "#/$defs/acIdList" },
        "deferredAcIds": { "$ref": "#/$defs/acIdList" },
        "blockedAcIds": { "$ref": "#/$defs/acIdList" },
        "manualOnlyAcIds": { "$ref": "#/$defs/acIdList" },
        "failedAcIds": { "$ref": "#/$defs/acIdList" },
        "clarificationRequiredAcIds": { "$ref": "#/$defs/acIdList" }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "interfaceCoverage": {
      "description": "Carries no acDesignCoveragePct on purpose: an AC only acquires an interface once a test plan links it to a scenario, so that denominator cannot exist before its numerator and the measure could only ever read 100% or null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acsWithScenarios",
        "acsWithExecutableAutomation",
        "acsExecuted",
        "acsPassed",
        "automationCoveragePct",
        "executionCoveragePct",
        "passCoveragePct"
      ],
      "properties": {
        "acsWithScenarios": { "type": "integer", "minimum": 0 },
        "acsWithExecutableAutomation": { "type": "integer", "minimum": 0 },
        "acsExecuted": { "type": "integer", "minimum": 0 },
        "acsPassed": { "type": "integer", "minimum": 0 },
        "automationCoveragePct": { "$ref": "#/$defs/percentage" },
        "executionCoveragePct": { "$ref": "#/$defs/percentage" },
        "passCoveragePct": { "$ref": "#/$defs/percentage" }
      }
    },
    "percentage": {
      "description": "Null when the source data required for the calculation is unavailable.",
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "acIdList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^AC-[A-Z][A-Z0-9]+-[0-9]+-[0-9]{3}$" }
    }
  }
}

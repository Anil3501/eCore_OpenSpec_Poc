{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecore-openspec-poc/schemas/lookup-index.schema.json",
  "title": "Traceability Lookup Index",
  "description": "Sparse index that maps stable identifiers to the capability RTM partitions that contain them. Avoids loading every RTM file when resolving a single identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "updatedAt", "dataClassification", "indexes"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "dataClassification": {
      "type": "string",
      "enum": ["REAL_JIRA_DATA", "SAMPLE_DATA", "MIXED_NOT_ALLOWED"]
    },
    "indexes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byJiraStoryId",
        "byRequirementId",
        "byAcId",
        "byTestPlanId",
        "byTestScenarioId",
        "byFeatureFile",
        "byExecutionId",
        "byDefectId"
      ],
      "properties": {
        "byJiraStoryId": { "$ref": "#/$defs/pointerMap" },
        "byRequirementId": { "$ref": "#/$defs/pointerMap" },
        "byAcId": { "$ref": "#/$defs/pointerMap" },
        "byTestPlanId": { "$ref": "#/$defs/pointerMap" },
        "byTestScenarioId": { "$ref": "#/$defs/pointerMap" },
        "byFeatureFile": { "$ref": "#/$defs/pointerMap" },
        "byExecutionId": { "$ref": "#/$defs/pointerMap" },
        "byDefectId": { "$ref": "#/$defs/pointerMap" }
      }
    }
  },
  "$defs": {
    "pointerMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "rtmPath"],
          "properties": {
            "capability": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "rtmPath": { "type": "string", "minLength": 1 },
            "traceIds": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
